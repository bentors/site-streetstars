rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ── Produtos ─────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.price is number
        && request.resource.data.price > 0;
      allow delete: if isAdmin();
    }

    // ── Usuários ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.email is string
        && request.resource.data.marketingConsent is bool
        && request.resource.data.keys().hasOnly([
          'email', 'name', 'phone',
          'marketingConsent', 'marketingConsentDate', 'created_at'
        ]);
      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'email', 'name', 'phone',
          'marketingConsent', 'marketingConsentDate', 'created_at'
        ]);
      allow delete: if false;

      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Pedidos ──────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);

      // ALTERADO: adicionado hasOnly para impedir campos arbitrários
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'userId', 'status', 'total', 'address', 'shipping',
          'payment', 'created_at', 'updated_at'
        ]);

      allow update, delete: if false;

      // Subcoleção de Itens
      match /items/{itemId} {
        allow read: if isAdmin() || isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId);

        // ALTERADO: validação de campos e limites de quantidade/preço
        allow create: if isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId)
          && request.resource.data.productId is string
          && request.resource.data.productId.size() > 0
          && request.resource.data.quantity is int
          && request.resource.data.quantity > 0
          && request.resource.data.quantity <= 10
          && request.resource.data.price is number
          && request.resource.data.price > 0
          && request.resource.data.name is string
          && request.resource.data.keys().hasOnly([
            'productId', 'name', 'price', 'quantity', 'size', 'color', 'img'
          ]);

        allow update, delete: if false;
      }
    }

    // ── Admins ───────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if false;
    }

  }
}